const state = {
  siteData: null
};

function formatPhone(number) {
  return number || '';
}

async function loadSiteData() {
  const response = await fetch('/api/site-data');
  const data = await response.json();
  state.siteData = data;
  renderSite(data);
}

function renderSite(data) {
  document.getElementById('site-name').textContent = data.centerName;
  document.getElementById('hero-title').textContent = data.slogan;
  document.getElementById('hero-subtitle').textContent = data.about.intro;
  document.getElementById('hero-phone').textContent = data.phone;
  document.getElementById('hero-hours').textContent = data.hours;
  document.getElementById('emergency-tag').textContent = data.emergency;
  document.getElementById('about-intro').textContent = data.about.intro;
  document.getElementById('mission-text').textContent = data.about.mission;
  document.getElementById('vision-text').textContent = data.about.vision;
  document.getElementById('contact-address').textContent = data.address;
  document.getElementById('contact-phone').textContent = data.phone;
  document.getElementById('contact-phone').href = `tel:${data.phoneHref}`;
  document.getElementById('contact-email').textContent = data.email;
  document.getElementById('contact-email').href = `mailto:${data.email}`;
  document.getElementById('contact-hours').textContent = data.hours;
  document.getElementById('year').textContent = new Date().getFullYear();

  const statsGrid = document.getElementById('stats-grid');
  statsGrid.innerHTML = data.stats
    .map(
      (stat) => `
        <div class="stat-card">
          <div class="stat-number">${stat.value}</div>
          <div class="stat-label">${stat.label}</div>
        </div>
      `
    )
    .join('');

  const servicesList = document.getElementById('services-list');
  servicesList.innerHTML = data.services
    .map(
      (service) => `
        <article class="service-card">
          <div class="service-icon">${service.icon}</div>
          <h3>${service.title}</h3>
          <p>${service.description}</p>
        </article>
      `
    )
    .join('');

  const departmentList = document.getElementById('department-list');
  departmentList.innerHTML = data.departments
    .map((department) => `<div class="department-item">${department}</div>`)
    .join('');

  const doctorList = document.getElementById('doctor-list');
  doctorList.innerHTML = data.doctors
    .map(
      (doctor) => `
        <article class="doctor-card">
          <div class="doctor-avatar">${doctor.initials}</div>
          <h3>${doctor.name}</h3>
          <span class="doctor-specialty">${doctor.specialty}</span>
          <p>${doctor.bio}</p>
        </article>
      `
    )
    .join('');

  const faqList = document.getElementById('faq-list');
  faqList.innerHTML = data.faqs
    .map(
      (faq) => `
        <article class="faq-item">
          <h3>${faq.question}</h3>
          <p>${faq.answer}</p>
        </article>
      `
    )
    .join('');
}

async function submitAppointment(event) {
  event.preventDefault();
  const form = event.target;
  const messageEl = document.getElementById('appointmentMessage');
  const formData = new FormData(form);

  const payload = {
    fullName: formData.get('fullName'),
    phone: formData.get('phone'),
    email: formData.get('email'),
    department: formData.get('department'),
    date: formData.get('date'),
    notes: formData.get('notes')
  };

  try {
    const response = await fetch('/api/appointments', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });

    const result = await response.json();
    if (!response.ok) throw new Error(result.message || 'Unable to book appointment.');

    messageEl.textContent = result.message;
    form.reset();
  } catch (error) {
    messageEl.textContent = error.message;
  }
}

async function submitContact(event) {
  event.preventDefault();
  const form = event.target;
  const messageEl = document.getElementById('contactMessage');
  const formData = new FormData(form);

  const payload = {
    name: formData.get('name'),
    email: formData.get('email'),
    phone: formData.get('phone'),
    message: formData.get('message')
  };

  try {
    const response = await fetch('/api/contact', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });

    const result = await response.json();
    if (!response.ok) throw new Error(result.message || 'Unable to send message.');

    messageEl.textContent = result.message;
    form.reset();
  } catch (error) {
    messageEl.textContent = error.message;
  }
}

document.addEventListener('DOMContentLoaded', async () => {
  await loadSiteData();
  document.getElementById('appointmentForm').addEventListener('submit', submitAppointment);
  document.getElementById('contactForm').addEventListener('submit', submitContact);
});
